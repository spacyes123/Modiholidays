NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Required only for the public-enquiry ingress. Set a separate long random secret.
PUBLIC_ENQUIRY_SECRET=
# Cloudflare Turnstile: ingress stays disabled until server secret and public site key are configured.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional authenticated email delivery; no email is sent unless both are configured.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
